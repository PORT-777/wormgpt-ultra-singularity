    "wormgpt-local": {
      "command": "D:\\xxxGPT\\WormGPT_Ultra_Singularity\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "D:\\xxxGPT\\WormGPT_Ultra_Singularity\\backend\\mcp_server.py"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
