#  .gitignore :: WormGPT Ultra
# NEVER commit real keys.
backend/.env
.env

# python
__pycache__/
*.py[cod]
.venv/
venv/

# node
node_modules/
dist/

# workspace sandbox contents
workspace/
# long-term memory store
backend/memory_data/
# sqlite + audit trail
backend/data/
# encrypted platform secrets
backend/data/.platform_secrets.enc
# local dev crypto keys — never commit
.plugin_key
backend/.plugin_key
# packaged artifacts
backend/build/
*.pkg
src-tauri/target/
*.msi
*.apk
*.exe
*.appimage
# local models
backend/models/*.gguf

# environment variants (example files stay tracked)
.env.*
!.env.example
backend/.env.*
!backend/.env.example

# database backups and migration artifacts (may contain user records)
backend/backups/
*.db-journal
*.db-wal
*.db-shm
backend/migrations/*.bak

# local object storage (user files never enter git)
backend/data/storage/

# pytest temporary workspaces (generated artifacts)
backend/.pytest_tmp/
