/* ============================================================
   🔥😈 PORT 777 EVIL ☠️🔥👹 â€” Squad Panel (Hermes-style)
   ØªÙ‚Ø³ÙŠÙ… Ø§Ù„Ù…Ù‡Ø§Ù… Ø¹Ù„Ù‰ Ø§Ù„Ù…ÙˆØ¯ÙŠÙ„Ø§Øª: Planner â†’ Workers â†’ Aggregator
   Ø¨ÙŠØ³Ù…Ø¹ SSE Ù…Ù† /api/gateway/squad/run + reconnect Ø¨Ù€ backoff
   ============================================================ */
import React, { useCallback, useEffect, useRef, useState } from 'react';
import { gatewayApi } from './gatewayClient.js';

const TEMPLATES = [
  { id: 'auto/coding:free', label: 'auto/coding:free', hint: 'Ø¬ÙˆØ¯Ø© ÙƒÙˆØ¯ Ø¹Ù„Ù‰ Ø§Ù„Ù€ free tiers' },
  { id: 'auto/fast:free', label: 'auto/fast:free', hint: 'Ø£Ø³Ø±Ø¹ Ù…ÙˆØ¯ÙŠÙ„ Ù…Ø¬Ø§Ù†ÙŠ Ø§Ù„Ø£ÙˆÙ„' },
  { id: 'auto/cheap:free', label: 'auto/cheap:free', hint: 'Ø§Ù„Ø£Ø±Ø®Øµ Ø§Ù„Ø£ÙˆÙ„ (ÙƒÙ„Ù‡ Ù…Ø¬Ø§Ù†ÙŠ Ø£ØµÙ„Ø§Ù‹)' },
  { id: 'auto/smart', label: 'auto/smart', hint: 'Ø¬ÙˆØ¯Ø© Ø§Ù„Ø£ÙˆÙ„ + Ø§Ø³ØªÙƒØ´Ø§Ù' },
  { id: 'auto/chaos', label: 'auto/chaos âš¡', hint: 'fan-out Ù…ØªÙˆØ§Ø²ÙŠ Ù„ÙƒÙ„ Ø§Ù„Ù…ÙˆØ¯ÙŠÙ„Ø§Øª' },
];

const EXAMPLES = [
  'Ø§Ø¨Ù†Ù Ù„ÙŠ ØªØ·Ø¨ÙŠÙ‚ ÙˆÙŠØ¨ ÙƒØ§Ù…Ù„ Ù„Ø¥Ø¯Ø§Ø±Ø© Ø£ÙÙƒØ§Ø± ÙÙŠØ¯ÙŠÙˆÙ‡Ø§Øª ÙŠÙˆØªÙŠÙˆØ¨: ÙˆØ§Ø¬Ù‡Ø© Ø¹Ø±Ø¨ÙŠØ©ØŒ Ø¥Ø¶Ø§ÙØ©/Ø­Ø°Ù/Ø¨Ø­Ø«ØŒ Ø­ÙØ¸ Ù…Ø­Ù„ÙŠØŒ ØªÙ‚ÙŠÙŠÙ… Ø¨Ø§Ù„Ù†Ø¬ÙˆÙ….',
  'Ø§Ø¹Ù…Ù„ Ø¨ÙˆØª Ø¯ÙŠØ³ÙƒÙˆØ±Ø¯ ÙŠÙ„Ø®Øµ Ø§Ù„Ù…Ù‚Ø§Ù„Ø§Øª Ø§Ù„Ø¹Ø±Ø¨ÙŠØ© ÙˆÙŠØ±Ø¯ Ø¹Ù„Ù‰ Ù‚Ù†Ø§Ø© Ù…Ø­Ø¯Ø¯Ø©ØŒ Ù…Ø¹ Ù„ÙˆØ­Ø© ØªØ­ÙƒÙ… Ø¨Ø³ÙŠØ·Ø©.',
  'Ø§Ø¨Ù†Ù Ø¯Ø§Ø´Ø¨ÙˆØ±Ø¯ Ù…Ø¨ÙŠØ¹Ø§Øª Ø¨ÙŠÙ‚Ø±Ø£ CSV ÙˆÙŠØ¹Ø±Ø¶ Charts ÙˆØªÙˆØ¨ Ø§Ù„Ù…Ù†ØªØ¬Ø§Øª Ø¨ØªØµÙ…ÙŠÙ… ØºØ§Ù…Ù‚.',
];

export default function SquadPanel({ onToast }) {
  const [task, setTask] = useState('');
  const [tpl, setTpl] = useState('auto/coding:free');
  const [running, setRunning] = useState(false);
  const [planner, setPlanner] = useState({ state: 'wait', model: '', pct: 0 });
  const [agg, setAgg] = useState({ state: 'wait', model: '', pct: 0 });
  const [workers, setWorkers] = useState([]); // {i,title,sub,model,provider,pct,state,output,tokens}
  const [result, setResult] = useState('');
  const [logs, setLogs] = useState([]);
  const abortRef = useRef(null);
  const retryRef = useRef({ tries: 0 });
  const termRef = useRef(null);

  const toast = (m, k) => onToast && onToast(m, k);
  const log = useCallback((msg, cls) => {
    setLogs((L) => [...L.slice(-160), { ts: new Date().toTimeString().slice(0, 8), msg, cls: cls || '' }]);
  }, []);
  useEffect(() => { termRef.current && (termRef.current.scrollTop = termRef.current.scrollHeight); }, [logs]);

  /* ---------- Ù…Ø¹Ø§Ù„Ø¬Ø© Ø£Ø­Ø¯Ø§Ø« Ø§Ù„Ù€ SSE ---------- */
  const handleEvent = useCallback((ev) => {
    retryRef.current.tries = 0; // Ø£ÙŠ Ø­Ø¯Ø« = Ø§Ù„Ø§ØªØµØ§Ù„ Ø³Ù„ÙŠÙ…
    switch (ev.type) {
      case 'planner_start':
        setPlanner({ state: 'run', model: `${ev.model} @ ${ev.provider}`, pct: 12 });
        log(`Planner â†’ ${ev.model} (${ev.provider}) Â· splitting task`, 'hl'); break;
      case 'planner_done':
        setPlanner({ state: 'done', model: `${ev.model} @ ${ev.provider}`, pct: 100 });
        setWorkers(ev.subtasks.map((s, i) => ({ i, ...s, model: ev.assignments[i].model, provider: ev.assignments[i].provider, pct: 0, state: 'wait' })));
        log(`Planner done â†’ ${ev.subtasks.length} subtasks Â· X-OmniRoute-Decision: ${ev.decision}`, 'ok'); break;
      case 'worker_start':
        setWorkers((W) => W.map((w) => w.i === ev.i ? { ...w, state: 'run' } : w));
        log(`worker#${ev.i + 1} â†’ ${ev.model} (${ev.provider}) Â· "${(ev.title || '').slice(0, 34)}â€¦"`, 'hl'); break;
      case 'worker_progress':
        setWorkers((W) => W.map((w) => w.i === ev.i ? { ...w, pct: ev.pct } : w)); break;
      case 'worker_fallback':
        setWorkers((W) => W.map((w) => w.i === ev.i ? { ...w, model: ev.to.model, provider: ev.to.provider } : w));
        log(`worker#${ev.i + 1} âš  ${ev.reason} on ${ev.from} â†’ fallback â†’ ${ev.to.model}`, 'warn'); break;
      case 'worker_done':
        setWorkers((W) => W.map((w) => w.i === ev.i ? { ...w, state: 'done', pct: 100, output: ev.output, tokens: ev.tokens } : w));
        log(`worker#${ev.i + 1} âœ“ done by ${ev.model} in ${ev.secs}s`, 'ok'); break;
      case 'agg_start':
        setAgg({ state: 'run', model: `${ev.model} @ ${ev.provider}`, pct: 20 }); break;
      case 'agg_chunk':
        setResult((R) => R + ev.text);
        setAgg((A) => ({ ...A, pct: Math.min(96, A.pct + 2) })); break;
      case 'agg_done':
        setAgg({ state: 'done', model: `${ev.model} @ ${ev.provider}`, pct: 100 });
        log('â”€â”€ RUN COMPLETE Â· cost: $' + (ev.cost ?? '0.00') + ' â”€â”€', 'ok');
        toast('ðŸ Ø§Ù„Ø³Ø±Ø¨ Ø®Ù„Ù‘Øµ Ø§Ù„Ù…Ù‡Ù…Ø©', 'ok'); break;
      case 'error':
        log(`â›” ${ev.message}`, 'err'); toast(ev.message, 'warn'); break;
      default: break;
    }
  }, [log, toast]);

  /* ---------- Ø§Ù„ØªØ´ØºÙŠÙ„ Ù…Ø¹ reconnect Ø¨Ù€ backoff (Ù†ÙØ³ Ù†Ù…Ø· Ø§Ù„Ø´Ø§Øª) ---------- */
  const start = useCallback(async () => {
    if (running) return;
    if (!task.trim()) return toast('Ø§ÙƒØªØ¨ Ø§Ù„Ù…Ù‡Ù…Ø© Ø§Ù„Ø£ÙˆÙ„', 'warn');
    setRunning(true); setWorkers([]); setResult(''); setLogs([]);
    setPlanner({ state: 'wait', model: '', pct: 0 }); setAgg({ state: 'wait', model: '', pct: 0 });

    const attempt = () => {
      abortRef.current = gatewayApi.runSquadStream(
        { task, template: tpl },
        handleEvent,
        () => { setRunning(false); }, // [DONE]
        (err) => {
          const tries = ++retryRef.current.tries;
          if (tries <= 5) {
            const delay = Math.min(8000, 1000 * 2 ** (tries - 1)); // 1sâ†’2sâ†’4sâ†’8s
            log(`connection lost â€” retry ${tries}/5 after ${delay / 1000}s`, 'warn');
            setTimeout(attempt, delay);
          } else {
            setRunning(false);
            log('reconnect failed Ã—5 â€” Ø§Ø³ØªØ®Ø¯Ù… Ø²Ø±Ø§Ø± Ø§Ù„ØªØ´ØºÙŠÙ„ Ù…Ù† Ø¬Ø¯ÙŠØ¯', 'err');
            toast('Ø§Ù„Ø§ØªØµØ§Ù„ Ø§ØªÙ‚Ø·Ø¹ Ù†Ù‡Ø§Ø¦ÙŠØ§Ù‹ â€” Ø¬Ø±Ù‘Ø¨ ØªØ§Ù†ÙŠ', 'warn');
          }
        },
      );
    };
    attempt();
  }, [running, task, tpl, handleEvent, toast, log]);

  const stop = useCallback(() => {
    abortRef.current && abortRef.current();
    setRunning(false);
    log('â–  ABORTED by user (Stop) Â· stream closed cleanly', 'err');
  }, [log]);

  useEffect(() => () => abortRef.current && abortRef.current(), []);

  return (
    <div className="gw-squad">
      <div className="gw-card">
        <div className="gw-sec-title"><span className="gw-ic">ðŸ§ </span> Ø³Ø±Ø¨ Ø§Ù„Ù…ÙˆØ¯ÙŠÙ„Ø§Øª â€” Ø£ÙŠ Ù…Ù‡Ù…Ø© ØªØªÙ‚Ø³Ù… Ø¹Ù„Ù‰ Ø§Ù„Ù…ÙˆØ¯ÙŠÙ„Ø§Øª</div>
        <div className="gw-sec-sub">
          Ø§Ù„Ù€ <b>Planner</b> ÙŠØ§Ø®Ø¯ Ø§Ù„Ù…Ù‡Ù…Ø© ÙˆÙŠÙ‚Ø³Ù…Ù‡Ø§ Ø®Ø·ÙˆØ§ØªØŒ ÙƒÙ„ Ø®Ø·ÙˆØ© ØªØªÙˆØ¬Ù‘Ù‡ Ù„Ù…ÙˆØ¯ÙŠÙ„ Ù…Ø®ØªÙ„Ù Ø­Ø³Ø¨ Ø§Ù„Ù‚Ø§Ù„Ø¨ØŒ ÙˆØ§Ù„Ù€ <b>Aggregator</b> ÙŠØ¬Ù…Ù‘Ø¹ Ø§Ù„Ù†ØªÙŠØ¬Ø©.
          Ø§Ù„Ø³Ø¬Ù„ ÙŠÙˆØ¶Ø­ <b>Ù…ÙŠÙ† ÙÙŠÙ† Ø¹Ù…Ù„ Ø¥ÙŠÙ‡</b> â€” Ø²ÙŠ logs ÙÙŠØ¯ÙŠÙˆ Hermes Ø¨Ø§Ù„Ø¸Ø¨Ø·.
        </div>

        <div className="gw-tpl-chips">
          {TEMPLATES.map((t) => (
            <button key={t.id} type="button" title={t.hint}
              className={'gw-tpl' + (tpl === t.id ? ' gw-tpl-active' : '')}
              onClick={() => setTpl(t.id)}>{t.label}</button>
          ))}
        </div>

        <textarea className="gw-squad-input" value={task}
          onChange={(e) => setTask(e.target.value)}
          placeholder="Ø§ÙƒØªØ¨ Ø§Ù„Ù…Ù‡Ù…Ø© Ù‡Ù†Ø§... Ù…Ø«Ø§Ù„: Ø§Ø¨Ù†Ù ØªØ·Ø¨ÙŠÙ‚ ÙˆÙŠØ¨ Ù„Ø¥Ø¯Ø§Ø±Ø© Ø£ÙÙƒØ§Ø± ÙÙŠØ¯ÙŠÙˆÙ‡Ø§Øª ÙŠÙˆØªÙŠÙˆØ¨" />

        <div className="gw-examples">
          {EXAMPLES.map((ex, i) => (
            <button key={i} type="button" className="gw-ex" onClick={() => setTask(ex)}>{['ðŸŽ¬ ØªØ·Ø¨ÙŠÙ‚ Ø£ÙÙƒØ§Ø± ÙŠÙˆØªÙŠÙˆØ¨', 'ðŸ¤– Ø¨ÙˆØª Ø¯ÙŠØ³ÙƒÙˆØ±Ø¯ Ù„Ù„Ù…Ù„Ø®ØµØ§Øª', 'ðŸ“Š Ø¯Ø§Ø´Ø¨ÙˆØ±Ø¯ Ù…Ø¨ÙŠØ¹Ø§Øª'][i]}</button>
          ))}
        </div>

        <div className="gw-run-row">
          <button className="gw-btn gw-btn-red gw-btn-run" disabled={running} onClick={start}>ðŸš€ Ù‚Ø³Ù‘Ù… ÙˆÙ†ÙÙ‘Ø° Ø¹Ù„Ù‰ Ø§Ù„Ø³Ø±Ø¨</button>
          {running && <button className="gw-btn gw-btn-stop" onClick={stop}>â¹ Ø¥ÙŠÙ‚Ø§Ù</button>}
          <span className="gw-hint">Ø§Ù„ØªÙˆØ¬ÙŠÙ‡ Ø­Ø³Ø¨ Ø§Ù„Ù‚Ø§Ù„Ø¨ Â· fallback ØªÙ„Ù‚Ø§Ø¦ÙŠ Ù„Ùˆ Ù…ÙˆØ¯ÙŠÙ„ ÙˆÙ‚Ø¹</span>
        </div>
      </div>

      {(workers.length > 0 || planner.state !== 'wait') && (
        <div className="gw-pipe">
          <div className="gw-pipe-side">
            <div className="gw-stage gw-planner">
              <h5>ðŸ—ºï¸ Planner</h5>
              <div className="mono gw-stage-m">{planner.model || 'â€”'}</div>
              <div className={'gw-st gw-st-' + planner.state}>
                {planner.state === 'run' ? 'Ø¨ÙŠÙ‚Ø³Ù… Ø§Ù„Ù…Ù‡Ù…Ø©â€¦' : planner.state === 'done' ? 'ØªÙ…Ø§Ù… âœ…' : 'ÙÙŠ Ø§Ù„Ø§Ù†ØªØ¸Ø§Ø±â€¦'}
              </div>
              <div className="gw-pbar"><i style={{ width: planner.pct + '%' }} /></div>
            </div>
            <div className="gw-arrow">â¬‡</div>
            <div className="gw-stage gw-agg">
              <h5>ðŸ§© Aggregator</h5>
              <div className="mono gw-stage-m">{agg.model || 'â€”'}</div>
              <div className={'gw-st gw-st-' + agg.state}>
                {agg.state === 'run' ? 'Ø¨ÙŠØ¬Ù…Ù‘Ø¹ Ø§Ù„Ù†ØªØ§Ø¦Ø¬â€¦' : agg.state === 'done' ? 'Ø§ØªØ¬Ù…Ø¹Øª âœ…' : 'ÙÙŠ Ø§Ù„Ø§Ù†ØªØ¸Ø§Ø±â€¦'}
              </div>
              <div className="gw-pbar"><i style={{ width: agg.pct + '%' }} /></div>
            </div>
          </div>
          <div className="gw-workers-col">
            <div className="gw-workers">
              {workers.map((w) => (
                <div key={w.i} className={'gw-worker gw-w-' + w.state}>
                  <div className="gw-w-t">#{w.i + 1} {w.title}</div>
                  <div className="gw-w-sub">{w.sub}</div>
                  <div className="gw-w-model mono">ðŸ¤– <b>{w.model}</b> @ {w.provider}</div>
                  <div className="gw-pbar"><i style={{ width: w.pct + '%' }} /></div>
                  {w.state === 'done' && <div className="gw-w-out">âœ“ {w.output}</div>}
                  {w.tokens && <div className="gw-w-tok">âš¡ {w.tokens}</div>}
                </div>
              ))}
            </div>
            {result && (
              <div className="gw-result">
                <h4>ðŸ§© Ø§Ù„Ù†ØªÙŠØ¬Ø© Ø§Ù„Ù†Ù‡Ø§Ø¦ÙŠØ© Ø§Ù„Ù…Ø¬Ù…Ù‘Ø¹Ø©</h4>
                <div className="gw-result-txt">{result}</div>
              </div>
            )}
          </div>
        </div>
      )}

      <div className="gw-term">
        <div className="gw-term-head">
          <span>gateway@squad â€” Ø³Ø¬Ù„ Ø§Ù„ØªÙˆØ¬ÙŠÙ‡</span>
          {running && <span className="gw-live"><i /> LIVE</span>}
        </div>
        <div className="gw-term-body mono" ref={termRef}>
          {logs.map((l, i) => (
            <div key={i} className={'gw-ln ' + l.cls}><span className="gw-ts">[{l.ts}]</span> {l.msg}</div>
          ))}
          {!logs.length && <div className="gw-ln">// Ø§Ø¶ØºØ· Â«Ù‚Ø³Ù‘Ù… ÙˆÙ†ÙÙ‘Ø°Â» ÙˆØ´ÙˆÙ Ù…ÙŠÙ† Ø¨ÙŠØ¹Ù…Ù„ Ø¥ÙŠÙ‡ ðŸŽ¬</div>}
        </div>
      </div>
    </div>
  );
}
