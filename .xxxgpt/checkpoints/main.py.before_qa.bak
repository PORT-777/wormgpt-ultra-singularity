# --------------------------------------------------------------------- #
#  MCP foundation + guarded execution bridge (Tasks 1-3)
# --------------------------------------------------------------------- #
class McpServerRequest(BaseModel):
    name: str = Field(min_length=1, max_length=120)
    enabled: bool = True
    transport: str = "stdio"
    command: str = ""
    args: List[str] = Field(default_factory=list)
    env: dict = Field(default_factory=dict)


class McpCallRequest(BaseModel):
    server: str = Field(min_length=1, max_length=120)
    tool: str = Field(min_length=1, max_length=200)
    arguments: dict = Field(default_factory=dict)
    full_access: bool = False


def _mcp_auth(authorization: str = "") -> None:
    if AUTH_REQUIRED:
        _verify_token((authorization or "").replace("Bearer ", "").strip())


@app.get("/api/mcp/status")
async def mcp_status():
    import mcp_manager
    return mcp_manager.status()


@app.get("/api/mcp/servers")
async def mcp_servers_list():
    import mcp_manager
    return {"servers": mcp_manager.list_servers()}


@app.post("/api/mcp/servers")
async def mcp_servers_upsert(req: McpServerRequest,
                             authorization: str = Header(default="")):
    _mcp_auth(authorization)
    import mcp_manager
    try:
        return mcp_manager.upsert_server(req.name, req.model_dump())
    except ValueError as exc:
        raise HTTPException(400, str(exc))


@app.delete("/api/mcp/servers/{name}")
async def mcp_servers_delete(name: str,
                             authorization: str = Header(default="")):
    _mcp_auth(authorization)
    import mcp_manager
    out = mcp_manager.remove_server(name)
    if not out.get("ok"):
        raise HTTPException(404, out.get("error", "not found"))
    return out


@app.post("/api/mcp/test/{name}")
async def mcp_server_test(name: str,
                          authorization: str = Header(default="")):
    _mcp_auth(authorization)
    import mcp_manager
    return await mcp_manager.test_server(name)


@app.post("/api/mcp/call")
async def mcp_server_call(req: McpCallRequest,
                          authorization: str = Header(default="")):
    """Guarded operator-initiated MCP tool call (Task 3). Never open/public."""
    _mcp_auth(authorization)
    import mcp_manager
    if not bool(getattr(config, "MCP_ENABLED", False)):
        raise HTTPException(403, "MCP execution is disabled (MCP_ENABLED=false)")
    if not bool(req.full_access):
        raise HTTPException(403, "full_access=true is required for MCP tool execution")
    result = await mcp_manager.call_tool(
        req.server, req.tool, req.arguments or {}, allow_execution=True)
    if not result.get("ok"):
        # Keep 200 with structured error so UI can display details; 4xx for policy.
        err = str(result.get("error", "MCP call failed"))
        if "requires Full Access" in err or "disabled" in err or "not found" in err:
            raise HTTPException(403, err)
    return result


