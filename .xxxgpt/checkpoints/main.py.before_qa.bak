#  Long-term memory (RAG)
# --------------------------------------------------------------------- #
@app.get("/api/memory")
async def memory_view(q: Optional[str] = None, k: int = 8, _=Depends(require_auth)):
    k = max(1, min(int(k or 8), 30))
    query = (q or "").strip()
    items = memory.recall(query, k=k) if query else memory.recent(k=k)
    payload = {"engine": memory.engine_name(), "enabled": config.MEMORY_ENABLED,
               "items": items, "k": k, "q": query}
    if hasattr(memory, "memory_status"):
        payload["status"] = memory.memory_status()
    return payload


@app.delete("/api/memory")
async def memory_clear():
    deleted = memory.wipe()
    return {"deleted": deleted, "engine": memory.engine_name()}



@app.get("/api/skills")
async def api_skills():
    try:
        import skills as skills_mod
        packs = skills_mod.load_packs()
        return {"count": len(packs), "packs": packs[:500]}
    except Exception as e:
        return {"count": 0, "packs": [], "error": str(e)}


@app.get("/api/files/read")
async def files_read(path: str, _=Depends(require_auth) if AUTH_REQUIRED else None):
    p = _safe(path)
    if not p.exists() or not p.is_file():
        raise HTTPException(404, "file not found")
    data = p.read_bytes()
    if len(data) > 300000:
        data = data[:300000]
    try:
        text = data.decode("utf-8")
    except Exception:
        text = data.decode("utf-8", errors="replace")
    return {"path": str(path), "content": text, "truncated": p.stat().st_size > 300000}

