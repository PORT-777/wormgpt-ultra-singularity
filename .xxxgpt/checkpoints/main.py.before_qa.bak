# --------------------------------------------------------------------- #
#  Auth (JWT-lite: HMAC-signed tokens, stdlib only)
# --------------------------------------------------------------------- #
ADMIN_PASSWORD = os.getenv("ADMIN_PASSWORD", "").strip()
AUTH_SECRET = (os.getenv("AUTH_SECRET", "").strip()
               or secrets.token_hex(32))
TOKEN_TTL = 12 * 3600  # 12h

AUTH_REQUIRED = bool(ADMIN_PASSWORD)


def _make_token() -> str:
    payload = json.dumps({"exp": time.time() + TOKEN_TTL}).encode()
    msg = base64.urlsafe_b64encode(payload).decode()
    sig = hmac.new(AUTH_SECRET.encode(), msg.encode(), hashlib.sha256).hexdigest()
    return f"{msg}.{sig}"


def _verify_token(token: str) -> None:
    if not AUTH_REQUIRED:
        return
    if not token:
        raise HTTPException(401, "authentication required")
    try:
        msg, sig = token.split(".", 1)
        good = hmac.new(AUTH_SECRET.encode(), msg.encode(),
                        hashlib.sha256).hexdigest()
        if not hmac.compare_digest(sig, good):
            raise ValueError
        payload = json.loads(base64.urlsafe_b64decode(msg))
        if payload.get("exp", 0) < time.time():
            raise ValueError("expired")
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(401, "invalid or expired token")


def require_auth(authorization: str = Header(default="")) -> None:
    _verify_token(authorization.replace("Bearer ", "").strip())


@asynccontextmanager
async def lifespan(app: FastAPI):
    storage.init()                     # SQLite migrations
    from scheduler import SCHEDULER
    SCHEDULER.start()                  # background agent cron
    log.info("🔥😈 PORT 777 EVIL ☠️🔥👹 booted | auth=%s | providers=%s",
             AUTH_REQUIRED, ROUTER.status())
    try:
        yield
    finally:
        await SCHEDULER.stop()
        try:
            from tools.browser_tool import shutdown_browser
            await shutdown_browser()
        except Exception:
            pass


app = FastAPI(title="🔥😈 PORT 777 EVIL ☠️🔥👹", version="4.0.0", lifespan=lifespan)
import gateway as _gw; app.mount('/api/gateway', _gw.app)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


