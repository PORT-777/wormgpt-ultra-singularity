@app.post("/api/transcribe")
async def transcribe(file: UploadFile = File(...),
                     language: Optional[str] = None):
    data = await file.read()
    suffix = Path(file.filename or "a.webm").suffix or ".webm"
    text = await voice.transcribe(data, suffix=suffix, language=language)
    return {"text": text, "ok": not text.startswith("ERROR")}


@app.get("/api/tts")
async def tts(text: str):
    wav = await voice.synthesize(text)
    if wav is None:
        raise HTTPException(
            503, "tts unavailable Ã¢â‚¬â€ install pyttsx3 (pip install pyttsx3)")
    return FileResponse(str(wav), media_type="audio/wav",
                        filename="🔥😈 PORT 777 EVIL ☠️🔥👹.wav")


