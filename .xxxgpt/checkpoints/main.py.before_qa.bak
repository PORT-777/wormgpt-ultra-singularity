# --------------------------------------------------------------------- #
# Frontend SPA (built) â€” mounted AFTER API routes so /api/* is never intercepted
# --------------------------------------------------------------------- #
if _FRONTEND_DIST.exists():
    from fastapi.staticfiles import StaticFiles
    assets_dir = _FRONTEND_DIST / "assets"
    if assets_dir.exists():
        app.mount("/assets", StaticFiles(directory=str(assets_dir)), name="assets")

    @app.get("/{full_path:path}", include_in_schema=False)
    async def spa_fallback(full_path: str):
        # Never shadow API/v1/docs/openapi
        if full_path.startswith("api") or full_path.startswith("v1") or full_path in {"docs", "openapi.json", "redoc", "favicon.ico"}:
            raise HTTPException(404, "not found")
        candidate = (_FRONTEND_DIST / full_path).resolve()
        try:
            candidate.relative_to(_FRONTEND_DIST.resolve())
        except Exception:
            candidate = None
        if candidate and candidate.is_file():
            return FileResponse(str(candidate))
        if _FRONTEND_INDEX.exists():
            return FileResponse(str(_FRONTEND_INDEX))
        raise HTTPException(404, "not found")
from langchain_core.messages import HumanMessage, SystemMessage
from pydantic import BaseModel
class EnhanceIn(BaseModel):
    text: str
    mode: str = "code"

@app.post("/api/prompt/enhance")
async def enhance_prompt(req: EnhanceIn):
    text = (req.text or "").strip()
    if not text:
        return {"text": ""}
    try:
        route, brain = ROUTER.resolve("auto")
        if not brain:
            return {"text": text}
        mode = (req.mode or "code").strip().lower() or "code"
        sys = (
            "You improve a user's prompt for an AI coding/work assistant. "
            "Return ONLY the improved prompt text, no preamble, no quotes, no markdown fences. "
            "Preserve intent, language, constraints, file names, and code. Make it clearer, specific, and actionable. "
            f"Mode/context: {mode}."
        )
        msg = await brain.ainvoke([SystemMessage(content=sys), HumanMessage(content=text[:12000])])
        out = (getattr(msg, "content", None) or str(msg) or "").strip()
        # strip accidental wrapping
        if out.startswith("```"):
            out = "\n".join([ln for ln in out.splitlines() if not ln.strip().startswith("```")]).strip()
        return {"text": out or text}
    except Exception:
        log.exception("prompt enhance failed")
        return {"text": text}

class FeedbackIn(BaseModel):
    session_id: str
    message_id: str
    vote: int

@app.post("/api/feedback")
async def feedback(req: FeedbackIn):
    try:
        fid = storage.add_feedback(req.session_id, req.message_id, req.vote)
        return {"ok": True, "id": fid}
    except Exception as exc:
        raise HTTPException(500, str(exc))
import checkpoint as _ckpt

class CheckpointManualIn(BaseModel):
    session_id: str = ""
    files: List[str] = Field(default_factory=list)
    message_id: str = ""

@app.get("/api/checkpoints")
async def list_ckpts(session_id: str = ""):
    return {"checkpoints": _ckpt.list_checkpoints(session_id)}

@app.get("/api/checkpoints/{cid}/diff")
async def ckpt_diff(cid: str, session_id: str = ""):
    try:
        return {"diff": _ckpt.diff_checkpoint(cid, session_id)}
    except FileNotFoundError as exc:
        raise HTTPException(404, str(exc))

@app.post("/api/checkpoints/{cid}/revert")
async def ckpt_revert(cid: str, session_id: str = ""):
    try:
        return _ckpt.revert_checkpoint(cid, session_id)
    except FileNotFoundError as exc:
        raise HTTPException(404, str(exc))

@app.post("/api/checkpoints/{cid}")
async def ckpt_manual(cid: str, req: CheckpointManualIn):
    # Manual snapshot endpoint (spec: POST /api/checkpoints/{id} optional).
    # {cid} is accepted for compatibility; stored id is generated.
    sid = req.session_id or "default"
    files = req.files or []
    if not files:
        raise HTTPException(400, "files list required for manual snapshot")
    return _ckpt.create_checkpoint(sid, req.message_id or f"manual:{cid}", files, kind="manual")
