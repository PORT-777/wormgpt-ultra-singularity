@app.post("/api/memory/index")
async def memory_index(_=Depends(require_auth)):
    status = memory.memory_status() if hasattr(memory, "memory_status") else {}
    if not bool(getattr(config, "MEMORY_ENABLED", False)):
        raise HTTPException(400, "memory is disabled (MEMORY_ENABLED=false)")
    if not bool(getattr(config, "FILE_INDEX_ENABLED", False)):
        raise HTTPException(400, "file indexing is disabled (FILE_INDEX_ENABLED=false)")
    indexed = await asyncio.to_thread(memory.index_workspace)
    if hasattr(memory, "memory_status"):
        status = memory.memory_status()
    return {"ok": True, "indexed_chunks": indexed, "status": status}


