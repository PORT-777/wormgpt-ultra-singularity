class ChatRequest(BaseModel):
    message: str = Field(min_length=1)
    session_id: Optional[str] = None
    model_route: Optional[str] = "auto"
    model: Optional[str] = None  # gateway/OmniRoute-style alias; routed through filtered pool
    mode: Optional[str] = None
    full_access: bool = False


class FileRequest(BaseModel):
    action: str = "list"
    path: str = "."
    content: str = ""


class LoginRequest(BaseModel):
    password: str


class TaskRequest(BaseModel):
    prompt: str = Field(min_length=1)
    interval_minutes: int = Field(ge=1, le=10080)  # 1min .. 7 days


# --------------------------------------------------------------------- #
#  Auth endpoints
# --------------------------------------------------------------------- #
@app.post("/api/login")
async def login(req: LoginRequest):
    if not AUTH_REQUIRED:
        return {"token": "dev-open", "auth": False}
    if req.password != ADMIN_PASSWORD:
        raise HTTPException(401, "wrong password")
    return {"token": _make_token(), "auth": True}


# --------------------------------------------------------------------- #
#  Chat -> SSE
# --------------------------------------------------------------------- #
@app.post("/api/chat")
async def chat(req: ChatRequest, authorization: str = Header(default="")):
    # God-mode double gate: explicit flag AND (a valid token if auth is on)
    if req.full_access and AUTH_REQUIRED:
        _verify_token(authorization.replace("Bearer ", "").strip())

    sid = req.session_id or uuid.uuid4().hex[:12]
    history = storage.get_history(sid)
    t_req0 = time.perf_counter()

    # Gateway activation + routing decision (header must be set before SSE starts)
    try:
        gw_activation = bool(_gw.gateway_settings().get("activation", True))
        gw_free_only = bool(_gw.gateway_settings().get("freeOnly", True))
    except Exception:
        gw_activation, gw_free_only = True, True

    requested_route = (req.model or req.model_route or "auto")
    effective_route = requested_route
    try:
        if not gw_activation:
            route_name, _brain = ROUTER.resolve("auto", task=req.message, activation=False, free_only=gw_free_only)
            effective_route = "local"
            decision = dict(getattr(ROUTER, "last_decision", {}) or {})
            if not decision.get("header"):
                m = str(getattr(config, "LOCAL_MODEL_NAME", "default") or "default")
                decision = {"provider": "local", "model": m, "reason": "activation-off", "ms": 0,
                            "activation_off": True, "header": f"local/{m} (activation-off)"}
        else:
            route_name, _brain = ROUTER.resolve(requested_route, task=req.message, activation=True, free_only=gw_free_only)
            effective_route = str(route_name or requested_route)
            decision = dict(getattr(ROUTER, "last_decision", {}) or {})
            if not decision.get("header"):
                decision = {"provider": effective_route, "model": effective_route, "reason": "resolved",
                            "ms": int((time.perf_counter()-t_req0)*1000), "header": f"{effective_route}/{effective_route} (resolved)"}
    except HTTPException:
        raise
    except Exception as exc:
        log.warning("routing decision failed: %s", exc)
        effective_route = requested_route or "auto"
        decision = {"provider": "local", "model": "default", "reason": "resolve-error",
                    "ms": int((time.perf_counter()-t_req0)*1000), "header": "local/default (resolve-error)"}

    storage.add_message(sid, "user", req.message)
    user_mid = f"msg_{int(time.time()*1000)}_{uuid.uuid4().hex[:6]}"
    decision_ms = int((time.perf_counter() - t_req0) * 1000)
    decision["ms"] = decision_ms
    log.info("chat_decision provider=%s model=%s reason=%s ms=%s session_id=%s",
             decision.get("provider"), decision.get("model"), decision.get("reason"), decision_ms, sid)

    async def event_stream():
        reply = ""
        try:
            async for event in ENGINE.run_stream(
                req.message, history=history,
                model_route=effective_route,
                mode=req.mode or "code",
                full_access=bool(req.full_access),
                session_id=sid,
                message_id=user_mid,
            ):
                if event["type"] == "final":
                    reply = event["data"]
                yield f"data: {json.dumps(event)}\n\n"
        except Exception as exc:  # pragma: no cover
            log.exception("agent crashed")
            yield f"data: {json.dumps({'type': 'error', 'data': str(exc)})}\n\n"
        finally:
            storage.add_message(sid, "assistant", reply or "[no reply]")
            yield f"data: {json.dumps({'type': 'done', 'data': sid})}\n\n"

    return StreamingResponse(
        event_stream(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "X-Accel-Buffering": "no",
            "X-Gateway-Decision": str(decision.get("header") or "local/default (resolved)"),
            "X-OmniRoute-Decision": str(decision.get("header") or "local/default (resolved)"),  # monitoring parity
        },
    )


