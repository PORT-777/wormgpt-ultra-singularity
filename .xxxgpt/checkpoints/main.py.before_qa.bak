# --------------------------------------------------------------------- #
#  File management (workspace sandbox)
# --------------------------------------------------------------------- #
MAX_UPLOAD = 200 * 1024 * 1024      # 200 MB "intelligence input" cap


@app.post("/api/files/upload")
async def files_upload(file: UploadFile = File(...),
                       subdir: str = "uploads"):
    """Intelligence-inputs protocol: any file lands in the sandbox and
    returns an instant profile (type guess, size, text preview) so the
    agent can analyse source/binaries/data files immediately."""
    data = await file.read()
    if len(data) > MAX_UPLOAD:
        raise HTTPException(413, f"file too large (> {MAX_UPLOAD // 1048576}MB)")

    name = Path(file.filename or "upload.bin").name   # no traversal
    target = _safe(f"{subdir.strip('/')}/{name}")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)

    suffix = target.suffix.lower()
    text_like = suffix in (".cpp", ".h", ".py", ".js", ".json", ".txt",
                           ".md", ".asm", ".ini", ".yaml", ".yml",
                           ".xml", ".csv", ".log")
    profile = {
        "path": str(target.relative_to(config.WORKSPACE_DIR)),
        "size": len(data),
        "kind": ("archive" if suffix in (".zip", ".tar", ".gz", ".rar")
                 else "text" if text_like
                 else "binary" if suffix in (".bin", ".exe", ".dll",
                                             ".dat", ".so", ".lib")
                 else "unknown"),
    }
    if text_like:
        preview = data[:4000].decode("utf-8", errors="replace")
        profile["preview"] = preview
    return profile


@app.get("/api/files")
async def files_list():
    root = config.WORKSPACE_DIR

    def walk(p: Path, depth: int = 0):
        items = []
        try:
            for child in sorted(p.iterdir()):
                items.append({
                    "name": child.name,
                    "path": str(child.relative_to(root)),
                    "is_dir": child.is_dir(),
                    "size": child.stat().st_size if child.is_file() else 0,
                    "depth": depth,
                })
                if child.is_dir() and depth < 4:
                    items.extend(walk(child, depth + 1))
        except PermissionError:
            pass
        return items

    return {"root": str(root), "files": walk(root)}


def _safe(path: str) -> Path:
    root = config.WORKSPACE_DIR.resolve()
    target = (root / path.lstrip("/\\")).resolve()
    if root != target and root not in target.parents:
        raise HTTPException(400, "path escapes workspace sandbox")
    return target


@app.post("/api/files")
async def files_ops(req: FileRequest):
    action = req.action.lower()
    try:
        if action == "list":
            return await files_list()
        if action == "read":
            t = _safe(req.path)
            if not t.is_file():
                raise HTTPException(404, "not a file")
            return {"path": req.path,
                    "content": t.read_text(encoding="utf-8",
                                           errors="replace")}
        if action == "write":
            t = _safe(req.path)
            t.parent.mkdir(parents=True, exist_ok=True)
            t.write_text(req.content, encoding="utf-8")
            return {"path": req.path, "written": len(req.content)}
        raise HTTPException(400, f"unknown action '{req.action}'")
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(500, str(exc))


@app.delete("/api/files")
async def files_delete(path: str):
    t = _safe(path)
    if t.is_dir():
        if t == config.WORKSPACE_DIR:
            raise HTTPException(400, "cannot delete workspace root")
        shutil.rmtree(t)
    elif t.is_file():
        t.unlink()
    else:
        raise HTTPException(404, "not found")
    return {"deleted": path}


