# WormGPT Ultra :: Environment template (no real secrets)
ADMIN_PASSWORD=
AUTH_SECRET=
ENCRYPTION_MASTER_KEY=
SECRET_STORE_PATH=
# Comma-separated public origins, e.g. https://port777-ai.onrender.com
CORS_ORIGINS=

# Providers (optional; leave blank to disable)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODEL_FALLBACKS=

HF_BASE_URL=https://api-inference.huggingface.co/v1
HF_API_KEY=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_FREE_ONLY=true

NVIDIA_BUILD_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BUILD_API_KEY=
NVIDIA_BUILD_FREE_ONLY=true

Z_AI_BASE_URL=https://z.ai
Z_AI_API_KEY=

KILO_BASE_URL=https://app.kilo.ai
KILO_API_TOKEN=

GATEWAY_FREE_ONLY=true
MEMORY_ENABLED=false
FILE_INDEX_ENABLED=false
MCP_ENABLED=false

WORKSPACE_DIR=
BACKEND_DIR=
SKILLS_DIR=

# ==========================================================================
# OAuth 2.0 / OIDC integrations (server-side only - never expose to frontend)
# ==========================================================================
# Exact callback to register with each provider:
#   http://127.0.0.1:7777/api/integrations/callback
# Set OAUTH_REDIRECT_URI only when the public URL differs from the request.
OAUTH_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=

VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

META_CLIENT_ID=
META_CLIENT_SECRET=

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- AI Computer (Daytona microVMs) ---
# pip install "daytona<1"
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
COMPUTER_PROVIDER=daytona
COMPUTER_IMAGE=ubuntu:24.04
COMPUTER_CPU=1
COMPUTER_MEMORY_GB=2
COMPUTER_DISK_GB=10
COMPUTER_TIMEOUT=300
COMPUTER_MAX_PER_USER=5
COMPUTER_TEMP_TTL=3600
COMPUTER_INSTALL_BASE_PACKAGES=true
# Development only, shared-kernel Docker (not hardware-isolated):
# COMPUTER_PROVIDER=docker-dev

# ==========================================================================
# Supabase — persistent PostgreSQL + object storage (production)
# ==========================================================================
# All values are placeholders. Never commit real credentials.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Service key: server-side ONLY. Get it from Dashboard -> Settings -> API.
SUPABASE_SECRET_KEY=
# Pooler DSN: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
PGSSLMODE=require
PGCONNECT_TIMEOUT=10
PGPOOL_MAX=10

# Object storage: auto | supabase | local | s3
STORAGE_BACKEND=auto
STORAGE_LOCAL_DIR=
FILE_SIGNING_SECRET=
BUCKET_AVATARS_MAX_BYTES=5242880
BUCKET_USER_FILES_MAX_BYTES=52428800
BUCKET_CHAT_MAX_BYTES=20971520
BUCKET_AI_MAX_BYTES=52428800
BUCKET_AGENT_MAX_BYTES=104857600
BUCKET_EXPORTS_MAX_BYTES=104857600

# Optional S3-compatible replacement for Supabase Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ==========================================================================
# Email delivery (verification / password reset)
# ==========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@port777.local

# ==========================================================================
# Payments — Paymob (test mode first; secrets stay server-side)
# ==========================================================================
PAYMOB_MODE=test
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
